{
  "type": {
    "family": {
      "heading": {
        "$type": "fontFamily",
        "$value": [
          "Source Serif 4",
          "Georgia",
          "serif"
        ],
        "$description": "Judul. Serif supaya terbaca di proyektor dan di kertas."
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
