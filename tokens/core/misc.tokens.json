{
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 3,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 6,
        "unit": "px"
      },
      "$description": "Default komponen."
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 10,
        "unit": "px"
      }
    },
    "pill": {
      "$type": "dimension",
      "$value": {
        "value": 999,
        "unit": "px"
      }
    }
  },
  "border": {
    "width": {
      "hairline": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "px"
        }
      },
      "thick": {
        "$type": "dimension",
        "$value": {
          "value": 2,
          "unit": "px"
        }
      }
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": "#12304F14",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": "#12304F1F",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 12,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "lg": {
      "$type": "shadow",
      "$value": {
        "color": "#12304F29",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 12,
          "unit": "px"
        },
        "blur": {
          "value": 32,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  },
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "normal": {
      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    },
    "slow": {
      "$type": "duration",
      "$value": {
        "value": 320,
        "unit": "ms"
      }
    }
  },
  "z": {
    "base": {
      "$type": "number",
      "$value": 0
    },
    "sticky": {
      "$type": "number",
      "$value": 100
    },
    "overlay": {
      "$type": "number",
      "$value": 200
    },
    "modal": {
      "$type": "number",
      "$value": 300
    },
    "toast": {
      "$type": "number",
      "$value": 400
    }
  },
  "breakpoint": {
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 640,
        "unit": "px"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 900,
        "unit": "px"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 1200,
        "unit": "px"
      }
    }
  }
}
