{
  "button": {
    "primary": {
      "bg": {
        "$type": "color",
        "$value": "{brand.primary}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{brand.hover}"
      },
      "bg-active": {
        "$type": "color",
        "$value": "{brand.active}"
      },
      "fg": {
        "$type": "color",
        "$value": "{text.on-brand}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.sm}"
      },
      "padding-x": {
        "$type": "dimension",
        "$value": "{space.6}"
      },
      "padding-y": {
        "$type": "dimension",
        "$value": "{space.4}"
      }
    },
    "secondary": {
      "bg": {
        "$type": "color",
        "$value": "transparent"
      },
      "fg": {
        "$type": "color",
        "$value": "{text.primary}"
      },
      "border": {
        "$type": "color",
        "$value": "{border.strong}"
      }
    }
  },
  "card": {
    "bg": {
      "$type": "color",
      "$value": "{surface.raised}"
    },
    "border": {
      "$type": "color",
      "$value": "{border.subtle}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{space.7}"
    },
    "shadow": {
      "$type": "shadow",
      "$value": "{shadow.sm}"
    }
  },
  "table": {
    "header-fg": {
      "$type": "color",
      "$value": "{text.secondary}"
    },
    "row-border": {
      "$type": "color",
      "$value": "{border.subtle}"
    },
    "row-hover-bg": {
      "$type": "color",
      "$value": "{surface.sunken}"
    }
  },
  "slide": {
    "kicker-fg": {
      "$type": "color",
      "$value": "{text.secondary}"
    },
    "rule": {
      "$type": "color",
      "$value": "{brand.primary}"
    },
    "rule-quiet": {
      "$type": "color",
      "$value": "{border.default}"
    },
    "footer-fg": {
      "$type": "color",
      "$value": "{text.muted}"
    },
    "page-no-fg": {
      "$type": "color",
      "$value": "{text.muted}"
    },
    "callout-bg": {
      "$type": "color",
      "$value": "{color.sand.500}"
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.lg}"
    },
    "photo-radius": {
      "$type": "dimension",
      "$value": "{radius.xl}"
    }
  }
}
